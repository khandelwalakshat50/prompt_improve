# Copy to .env and fill in the keys you have. Providers without a key are hidden in the UI.
# Keys are read server-side only and never sent to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional base URL overrides (proxies, gateways, local mocks). Defaults to each provider's public API.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# DEEPSEEK_BASE_URL=
# GROQ_BASE_URL=
